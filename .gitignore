# ==============================================================================
# .gitignore - Git 버전 관리 제외 목록 (보안 및 환경 설정 보호)
# ==============================================================================

# 1. 민감한 환경 변수 및 보안 키 파일 (절대 커밋 금지)
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production

# 2. 의존성 패키지 폴더
node_modules/
package-lock.json

# 3. 로그 및 디버깅 파일
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 4. OS 및 에디터 임시 설정 파일
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj

# 5. 배포 빌드 산출물 (Vercel)
.vercel
dist/
build/
